# ---------------------------------------------------------------------------
# Pipeline working data
# ---------------------------------------------------------------------------
# Everything under data/ is regenerated by running the pipeline. The pristine
# reference inputs are kept in examples/ and copied into data/00_input/ by hand.
data/00_input/*
!data/00_input/.gitkeep
data/01_split/
data/02_aligned/
data/03_modules/
data/04_jobs/

# Large G-code and machine files anywhere outside examples/
*.gcode
*.bgcode
!examples/*.gcode

# CAD and slicer project files
*.prt
*.3mf
*.auprojx
*.stl
!examples/*.stl

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
